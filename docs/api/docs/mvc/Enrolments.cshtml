@model List<EnrolmentDto>
@{ ViewData["Title"] = "My enrolments"; }
<h2 class="mb-3">My enrolments</h2>
@if (!Model.Any())
{
    <div class="alert alert-info">You have not enrolled in any events yet. <a asp-action="Events">Browse events</a>.</div>
}
else
{
    <div class="table-responsive"><table class="table align-middle">
        <thead><tr><th>Event</th><th>Type</th><th>Date</th><th>Location</th><th>Distance</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td><a asp-action="EventDetails" asp-route-id="@e.EventId">@e.EventName</a></td>
                <td><partial name="_EventBadge" model="e.EventType" /></td>
                <td>@e.EventDate.ToString("dd MMM yyyy HH:mm")</td>
                <td>@e.Location</td>
                <td>@e.DistanceKm.ToString("0.##") km</td>
                <td>@(e.HasResult ? "Result recorded" : e.EventDate < DateTime.Now ? "Completed" : "Upcoming")</td>
                <td>
                    @if (!e.HasResult && e.EventDate >= DateTime.Now)
                    {
                        <form asp-action="Withdraw" asp-route-id="@e.Id" method="post" onsubmit="return confirm('Withdraw from this event?');"><button class="btn btn-sm btn-outline-danger" type="submit">Withdraw</button></form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table></div>
}
