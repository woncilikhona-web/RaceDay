@model CategoryDto
@{ ViewData["Title"] = "Edit category"; }
<div class="row justify-content-center"><div class="col-md-6">
    <h2 class="mb-3">Edit category</h2>
    <form asp-action="EditCategory" asp-route-id="@Model.Id" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Description" class="form-label"></label><input asp-for="Description" class="form-control" /><span asp-validation-for="Description" class="text-danger"></span></div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Categories" class="btn btn-link">Cancel</a>
    </form>
</div></div>
