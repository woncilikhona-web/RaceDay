@model ParticipantsViewModel
@{ ViewData["Title"] = "Participants"; }
<a asp-action="Events" class="d-block mb-3">&larr; Back to my events</a>
<h2>@Model.Event.Name <partial name="_EventBadge" model="Model.Event.EventType" /></h2>
<p class="text-muted">@Model.Event.Date.ToString("dd MMM yyyy HH:mm") &middot; @Model.Event.Location &middot; @Model.Event.DistanceKm.ToString("0.##") km &middot; @Model.Event.CategoryName</p>
<h4>Enrolled participants (@Model.Participants.Count)</h4>
@if (!Model.Participants.Any())
{
    <div class="alert alert-info">Nobody has enrolled yet.</div>
}
else
{
    <div class="table-responsive"><table class="table align-middle">
        <thead><tr><th>Name</th><th>Email</th><th>Enrolled</th><th>Finish time</th><th>Position</th><th>Notes</th><th></th></tr></thead>
        <tbody>
        @foreach (var p in Model.Participants)
        {
            <tr>
                <td>@p.FullName</td>
                <td>@p.Email</td>
                <td>@p.EnrolledAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                <td>@(p.FinishTime ?? "-")</td>
                <td>@(p.Position.HasValue ? p.Position.ToString() : "-")</td>
                <td>@p.Notes</td>
                <td class="text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-action="RecordResult" asp-route-eventId="@Model.Event.Id" asp-route-enrolmentId="@p.EnrolmentId">@(p.ResultId.HasValue ? "Edit result" : "Record result")</a>
                    @if (p.ResultId.HasValue)
                    {
                        <form asp-action="DeleteResult" asp-route-id="@p.ResultId" asp-route-eventId="@Model.Event.Id" method="post" class="d-inline" onsubmit="return confirm('Remove this result?');"><button class="btn btn-sm btn-outline-danger" type="submit">Remove</button></form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table></div>
}
