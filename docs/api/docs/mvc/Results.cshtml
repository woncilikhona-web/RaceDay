@model List<ResultDto>
@{ ViewData["Title"] = "My results"; }
<h2 class="mb-3">My results</h2>
@if (!Model.Any())
{
    <div class="alert alert-info">No results have been recorded for you yet.</div>
}
else
{
    <div class="table-responsive"><table class="table align-middle">
        <thead><tr><th>Event</th><th>Type</th><th>Date</th><th>Distance</th><th>Finish time</th><th>Position</th><th>Notes</th></tr></thead>
        <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.EventName<div class="text-muted small">@r.Location</div></td>
                <td><partial name="_EventBadge" model="r.EventType" /></td>
                <td>@r.EventDate.ToString("dd MMM yyyy")</td>
                <td>@r.DistanceKm.ToString("0.##") km</td>
                <td><strong>@r.FinishTime</strong></td>
                <td>@(r.Position.HasValue ? r.Position.ToString() : "-")</td>
                <td>@r.Notes</td>
            </tr>
        }
        </tbody>
    </table></div>
}
